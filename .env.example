# ========================================================
# ViBa Web Development Solutions (vibawebdev.com)
# Environment Configuration Template
# ========================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production.

# Public Agency Settings
NEXT_PUBLIC_APP_NAME="ViBa Web Development Solutions"
NEXT_PUBLIC_APP_URL="https://vibawebdev.com"

# Firebase Client SDK Configuration (Client-Side)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="viba-webdev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="viba-webdev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="viba-webdev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Firebase Admin SDK Configuration (Server-Side Next.js API Routes)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID="viba-webdev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@viba-webdev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# API Security Secret (Used for protecting administrative API routes under /api)
API_SECRET_KEY="your-strong-random-api-secret-key"

# Inquiries Notification Dispatch
INQUIRY_NOTIFICATION_EMAIL="contact@vibawebdev.com"

# Vercel Deployment Settings (Injected automatically by Vercel in production)
# VERCEL="1"
# VERCEL_ENV="production"
# VERCEL_URL="vibawebdev.com"

